{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2023", "ES2024.Promise"]
  },
  // Whole test tree. New files are checked by default. `lib` includes
  // ES2024.Promise so `Promise.withResolvers` in tests type-checks.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
